FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    GAMEQA_CONFIG=configs/openrouter_gemini_pilot.yaml PYTHONPATH=/app/src \
    GAMEQA_PUBLIC_REPLAY=1 PORT=10000
WORKDIR /app
COPY requirements.replay.txt ./
RUN pip install --no-cache-dir -r requirements.replay.txt
# Source is importable through PYTHONPATH; installing the full package would pull Torch.
COPY src ./src
COPY app.py ./
COPY configs ./configs
COPY scripts ./scripts
COPY deploy ./deploy
COPY .streamlit/config.toml .streamlit/config.toml
RUN useradd --create-home --uid 1000 gameqa && chown -R gameqa:gameqa /app
USER gameqa
EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
    CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','10000')+'/_stcore/health',timeout=3)"
CMD ["python", "scripts/start_free_replay.py"]
